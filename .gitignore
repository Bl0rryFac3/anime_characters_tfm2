# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.workshop_id
*.dll
*.aseprite
*.xcf

.cargo/*
.vscode/*
art_src/*
tools/*
docs/*
previews/*
hook-target.json
rust-toolchain.toml
item-builds.json

# --- project-specific -------------------------------------------------
# Build output
build.log

# Editor / tool backups - never publish these
*.bak
*.bak2
*.bak3
*.orig
*.pre_rescale

# Local scratch folders that are not part of the mod
DOWNLOADS*/
*DOWNLOADS*/

# Anything left over from the removed Xenomophobic champion.
# The assembler already refuses to copy these; this stops them
# sneaking back in later.
xenomophobic*
*xenomophobic*
*xeno_*
monster_xenomophobic*
